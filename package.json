{
  "name": "xix-vectorizer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "engine:sync": "node scripts/sync-engine.mjs",
    "engine:verify": "node scripts/sync-engine.mjs --verify",
    "engine:verify-generated": "node scripts/sync-engine.mjs --verify-generated",
    "dev": "vite",
    "build": "npm run engine:verify-generated && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
